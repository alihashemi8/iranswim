# ==========================================
# IranSwim Production Environment Variables
# ==========================================

# Port (پورت عمومی وب روی سرور)
PORT=80

# Django Security
DJANGO_SECRET_KEY=change-this-in-production-to-a-very-long-random-string-50-characters-minimum
DJANGO_DEBUG=False

# Domains & IPs (نام دامنه و آی‌پی سرور خود را با کاما جدا کنید)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://yourdomain.com,https://yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://yourdomain.com,https://yourdomain.com

# PostgreSQL Database Configuration
POSTGRES_DB=iranswim
POSTGRES_USER=iranswim_user
POSTGRES_PASSWORD=put_a_super_strong_password_here_123!

